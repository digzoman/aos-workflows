{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/digzoman/aos-workflows/blob/main/scaffold/aos-w/spec/schemas/visualization-snapshot.schema.json",
  "title": "AOS-W read-only workflow visualization snapshot",
  "type": "object",
  "required": [
    "visualization_schema",
    "mode",
    "title",
    "generated_at",
    "verification",
    "nodes"
  ],
  "properties": {
    "visualization_schema": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "TEMPLATE",
        "INSTANCE",
        "RUN"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "enum": [
        "SOURCE_SNAPSHOT_UNVERIFIED",
        "EVENTS_RECONCILED",
        "HOST_VALIDATED"
      ]
    },
    "public_export": {
      "type": "boolean",
      "default": false
    },
    "template_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "graph_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_seq_observed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "warning": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "type": "object",
        "required": [
          "id",
          "needs",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$"
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "task",
              "review",
              "approval",
              "join",
              "child_generator",
              null
            ]
          },
          "needs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            }
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "READY",
              "RUNNING",
              "COMPLETE",
              "ACCEPTED",
              "WAIT_DEPENDENCY",
              "WAIT_CONDITION",
              "WAIT_APPROVAL",
              "REVIEW_WAIT",
              "NEEDS_REWORK",
              "BLOCKED",
              "RECONCILE_REQUIRED",
              "CANCELLED",
              "FAILED",
              "SKIPPED",
              "SKIPPED_BY_CONDITION",
              "SUPERSEDED",
              "STALE",
              "UNKNOWN",
              "CREATED",
              "PAUSED",
              "PENDING"
            ]
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 18000
          },
          "inputs": {},
          "outputs": {},
          "quality": {},
          "contract": {},
          "retry": {},
          "when": {},
          "owner": {},
          "attempts": {},
          "review": {},
          "evidence": {},
          "notes": {},
          "child_template": {},
          "source": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
