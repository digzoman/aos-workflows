{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compound workflow template",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "template_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "trigger": {
      "$ref": "common.schema.json#/$defs/trigger"
    },
    "policy": {
      "$ref": "common.schema.json#/$defs/policy"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/skill"
      }
    },
    "parameters": {
      "type": "object"
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "child_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "template_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "version": {
                "type": "string"
              },
              "content_digest": {
                "type": "string"
              },
              "bindings": {
                "type": "object"
              },
              "depends_on": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "authorization_mode": {
                "enum": [
                  "per_child",
                  "approved_batch",
                  "automatic_within_existing_scope"
                ]
              }
            },
            "required": [
              "child_id",
              "template_id",
              "version",
              "content_digest",
              "depends_on",
              "authorization_mode"
            ]
          }
        },
        "join": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "enum": [
                "all_accepted",
                "any_accepted",
                "quorum"
              ]
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "children": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              }
            }
          },
          "required": [
            "policy",
            "children"
          ]
        }
      },
      "required": [
        "children",
        "join"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/node"
          }
        }
      },
      "required": [
        "nodes"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gate"
      }
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "version",
    "name",
    "trigger",
    "policy",
    "composition",
    "graph"
  ]
}
