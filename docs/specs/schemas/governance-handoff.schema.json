{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance-aware reviewer and permission handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "handoff_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "graph_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    },
    "completed": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "active": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "ready": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/actor"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pending_quality": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "pending_provider_actions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "security_level": {
      "const": "cooperative_no_authentication"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "run_id",
    "graph_revision",
    "actor",
    "at",
    "last_event_seq",
    "completed",
    "active",
    "ready",
    "claims",
    "next_action",
    "security_level"
  ]
}
