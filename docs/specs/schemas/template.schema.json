{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow template",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "template_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 0
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "array",
              "object"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "description": {
            "type": "string",
            "minLength": 0
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "trigger": {
      "$ref": "common.schema.json#/$defs/trigger"
    },
    "policy": {
      "$ref": "common.schema.json#/$defs/policy"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/skill"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gate"
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/node"
          }
        }
      },
      "required": [
        "nodes"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "version",
    "name",
    "trigger",
    "policy",
    "graph"
  ]
}
