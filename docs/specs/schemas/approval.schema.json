{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped action authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "approval_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issuer": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "decision": {
      "enum": [
        "GRANTED",
        "DENIED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/action"
      }
    },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_resource_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifact"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "supersedes_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "reason": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "task_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "graph_revision": {
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "run_id",
    "issuer",
    "decision",
    "actions",
    "resource_ids",
    "issued_at"
  ]
}
