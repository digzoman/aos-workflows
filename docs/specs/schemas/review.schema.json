{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version-bound review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "review_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "gate_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "rubric_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "rubric_revision": {
      "type": "string"
    },
    "producer": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "reviewer": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "independent_required": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/artifact"
      }
    },
    "required_artifact_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "verdict": {
      "enum": [
        "PENDING",
        "PASS",
        "REVISE",
        "INSUFFICIENT_EVIDENCE",
        "BLOCKED",
        "WAIVED_BY_OWNER"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "approval_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "extensions": {
      "type": "object"
    },
    "graph_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "correction": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/time"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "task_id",
    "gate_id",
    "rubric_id",
    "rubric_revision",
    "reviewer",
    "artifacts",
    "verdict",
    "created_at"
  ]
}
