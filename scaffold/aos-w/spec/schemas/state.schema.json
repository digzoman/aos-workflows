{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived AOS-W current state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "graph_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_digest": {
      "type": "string"
    },
    "integrity_level": {
      "enum": [
        "verified",
        "advisory",
        "unverified"
      ]
    },
    "run_status": {
      "enum": [
        "CREATED",
        "ACTIVE",
        "WAITING",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED",
        "PAUSED",
        "FAILED"
      ]
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "PROPOSED",
              "WAIT_AUTHORIZATION",
              "WAIT_DEPENDENCY",
              "READY",
              "CLAIMED",
              "RUNNING",
              "WAIT_EXTERNAL",
              "WAIT_REVIEW",
              "FAILED",
              "NEEDS_REWORK",
              "BLOCKED",
              "RECONCILE_REQUIRED",
              "COMPLETE",
              "SKIPPED",
              "CANCELLED",
              "SUPERSEDED",
              "PAUSED"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "active_attempt_id": {
            "type": "string"
          },
          "claim_id": {
            "type": "string"
          },
          "graph_revision": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "accepted_artifacts": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/artifact"
            }
          },
          "blocked_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "owner": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/actor"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_attempt_owner": {
            "$ref": "common.schema.json#/$defs/actor"
          },
          "started_at": {
            "$ref": "common.schema.json#/$defs/time"
          },
          "last_attempt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/artifact"
            }
          },
          "pending_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retry": {
            "type": [
              "object",
              "null"
            ]
          },
          "last_error": {
            "type": [
              "object",
              "null"
            ]
          },
          "review": {
            "type": [
              "object",
              "null"
            ]
          },
          "resume_status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "attempts",
          "graph_revision"
        ]
      }
    },
    "eligible_tasks": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "task_id",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "pending_provider_operations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "extensions": {
      "type": "object"
    },
    "paused": {
      "type": "boolean"
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "active_steps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/actor"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "locator": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "task_id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "artifact_id",
          "locator",
          "revision",
          "task_id"
        ],
        "additionalProperties": true
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "audit_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "graph_revision",
    "state_revision",
    "updated_at",
    "last_event_seq",
    "integrity_level",
    "run_status",
    "tasks"
  ]
}
