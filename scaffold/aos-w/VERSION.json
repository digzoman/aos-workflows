{
  "aosw_version": "0.6.0",
  "schema_version": "1.0.0",
  "distribution": {
    "format": "aos-w-standalone-zip-v1",
    "clean_user_seed": true,
    "manifest": "DISTRIBUTION-MANIFEST.json",
    "runtime_dependencies": [],
    "optional_build_tool": "scripts/aosw-distribution.py",
    "optional_init_tool": "scripts/aosw-ops.py",
    "user_data_policy": "release_excludes_user_instances_custom_templates_and_private_config",
    "mode": "file-only-manual"
  },
  "status": "portable-manual-core-with-separate-optional-install-and-checkpoint-tools",
  "minimum_requirements": [
    "capable agent",
    "persistent writable files within agent-files"
  ],
  "mandatory_programming_runtime": false,
  "mandatory_git": false,
  "mandatory_scheduler": false,
  "exclusive_claims": "not implemented",
  "automatic_graph_executor": "not implemented",
  "upgrades": {
    "protected_paths": [
      "README.md",
      "PROTOCOL.md",
      "VERSION.json",
      "spec",
      "references",
      "templates"
    ],
    "preserve_user_path": "agent-files"
  },
  "composition": {
    "manual": "documented",
    "optional_py_yaml_helper": "tools/composition/",
    "automatic_dispatch": "not implemented",
    "shared_claims": "not implemented"
  },
  "state": {
    "manual": "documented",
    "optional_python_helper": "tools/state/",
    "history": "sha256-chain-for-new-helper-events",
    "local_checkpoint_recovery": "implemented_in_optional_helper",
    "shared_writes": "not implemented",
    "provider_writes": "not implemented",
    "scheduler": "not implemented"
  },
  "governance": {
    "manual": "documented",
    "optional_python_helper": "tools/governance/",
    "quality_gates": [
      "deterministic",
      "ai_independent",
      "human",
      "self_review"
    ],
    "claim_enforcement": "advisory_only",
    "human_identity_authentication": "not_implemented",
    "provider_actions": "not_implemented"
  },
  "git": {
    "optional": true,
    "modes": [
      "standalone_single_writer",
      "git_mirrored_single_writer",
      "shared_coordinated"
    ],
    "preferred_claim_adapter": "git_ref_cas_provisional",
    "verified_on": "local_bare_git_remote_only",
    "lfs_server_tested": false,
    "hosted_github_claim_tested": false,
    "no_external_api_fencing": true
  }
}
